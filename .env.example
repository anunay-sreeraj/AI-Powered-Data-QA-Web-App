# Copy this file to .env and fill in your key. Any OpenAI-compatible endpoint
# works unchanged - just swap these three values.

# --- OpenAI (current default) ---
# Get a key at https://platform.openai.com/api-keys (requires billing credit).
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# Cheaper alternatives on the same account: gpt-4o-mini, gpt-5-nano

# --- Groq (free, open-weight models - the assignment's literal "open-source
# AI models" constraint - but has tight free-tier rate limits) ---
# LLM_API_KEY=your-groq-api-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local, open-weight, no API key/rate limits at all) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
